# 環境変数の雛形。`.env.local` にコピーして実値を入れる（.env.local は git 管理外）。
# NEXT_PUBLIC_* はクライアントへ露出する。それ以外はサーバー専用（ブラウザに出さない）。

# --- アプリ（地図表示・クライアント） ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=your-map-id
# Google Analytics（任意・未設定なら計測なし）
NEXT_PUBLIC_GA_ID=

# --- データ生成パイプライン（サーバー専用・地図表示用とは別キー推奨） ---
GOOGLE_GEOCODING_API_KEY=your-geocoding-api-key

# --- ユーザー報告フォーム /api/report（サーバー専用） ---
# fine-grained PAT（対象リポジトリのみ・Issues:write のみ＝最小権限）を推奨。
# 未設定だと報告フォームは 503（送信不可）になる。本番は Vercel の環境変数にも登録すること。
GITHUB_REPORT_TOKEN=your-github-fine-grained-pat
GITHUB_REPORT_REPO=Riochin/ls-inib-map
